# Environment: development | test | production
NODE_ENV=development

# Server port
PORT=3000

# PostgreSQL connection string (replace with real credentials)
DATABASE_URL=postgresql://api_limit:changeme@localhost:5432/api_limit

# JWT settings (use a strong random secret in production)
JWT_SECRET=replace-with-a-minimum-32-character-random-secret
JWT_ISSUER=api_limit
JWT_AUDIENCE=api_limit_users

# Mail transport: console (logs to stdout) or smtp
MAIL_DRIVER=console
MAIL_FROM=noreply@example.com

# SMTP settings (only required when MAIL_DRIVER=smtp)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# OpenAI (job offer parser)
OEPNIA_API_KEY=replace-with-openai-api-key
OPENIA_MODEL=gpt-5-mini
