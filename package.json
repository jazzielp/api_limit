{
  "name": "api_limit",
  "version": "1.0.0",
  "description": "Express 5 + TypeScript API with JWT auth, email verification, password reset, API keys and per-user daily rate limits.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "NODE_ENV=development node --env-file=.env.development node_modules/tsx/dist/cli.mjs watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "NODE_ENV=production node --env-file=.env dist/server.js",
    "test": "NODE_ENV=test node --env-file=.env.test node_modules/vitest/vitest.mjs run",
    "test:watch": "NODE_ENV=test node --env-file=.env.test node_modules/vitest/vitest.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "prisma:generate": "NODE_ENV=development node --env-file=.env.development node_modules/prisma/build/index.js generate",
    "prisma:migrate": "NODE_ENV=development node --env-file=.env.development node_modules/prisma/build/index.js migrate dev",
    "prisma:migrate:prod": "NODE_ENV=production node --env-file=.env node_modules/prisma/build/index.js migrate deploy",
    "prisma:studio": "NODE_ENV=development node --env-file=.env.development node_modules/prisma/build/index.js studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@scalar/express-api-reference": "0.10.13",
    "argon2": "^0.45.1",
    "express": "^5.0.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.10.0",
    "pg": "^8.13.0",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@prisma/config": "^7.9.1",
    "@redocly/openapi-core": "^2.46.0",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.5.0",
    "@types/nodemailer": "^6.4.17",
    "@types/supertest": "^6.0.2",
    "ajv": "^8.20.0",
    "prisma": "^7.9.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "vitest": "^2.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["argon2"]
  }
}
